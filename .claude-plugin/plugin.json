{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "cyanheads-mcp-server",
  "version": "0.4.2",
  "description": "Fleet discovery for the cyanheads MCP ecosystem — semantic search + install snippets.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/cyanheads-mcp-server#readme",
  "repository": "https://github.com/cyanheads/cyanheads-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "mcp-discovery", "mcp-fleet", "semantic-search"],
  "mcpServers": {
    "cyanheads-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/cyanheads-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
