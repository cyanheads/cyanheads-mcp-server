# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp       # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                   # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # auto | stateful | stateless. Set here, not left to the schema default
                                    # (auto, which resolves to stateful). This server holds no per-session
                                    # state, and src/index.ts declares the same mode via createApp, so this
                                    # line restates the server's posture rather than overriding it.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# LOG_TOOL_FAILURE_PAYLOADS=false   # Log failed arguments/results; redaction is by key, not free-form content
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384  # UTF-8 byte cap for each logged payload

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=                # Base URL for traces and metrics (e.g., http://localhost:4318)
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=           # Explicit logs URL; never derived from the base endpoint

# ── Catalog ──────────────────────────────────────────────────────────
# CATALOG_URL=https://caseyjhand.com/fleet.json   # Remote fleet.json endpoint (schema v2); absolute URL
# CATALOG_FETCH_TIMEOUT_MS=10000                  # HTTP fetch timeout; must be > 0
# CATALOG_REFRESH_SECONDS=3600                    # Background poll interval; 0 disables refresh, otherwise > 0

# ── Embeddings ────────────────────────────────────────────────────────
# EMBEDDING_MODEL_ID=Snowflake/snowflake-arctic-embed-m-v1.5  # Must match fleet.json.embeddingModel
# SIMILARITY_FLOOR=0.3                                        # Cosine similarity cutoff for cyanheads_search_catalog results; [0, 1]
